# Resqly customer app (apps/customer-mobile) — Expo/EAS build profile env.
# Only EXPO_PUBLIC_* values are ever embedded in the app bundle.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the customer web app — all writes (vehicles, insurance,
# cases, BankID, tow requests) go through its server API routes.
EXPO_PUBLIC_CUSTOMER_API_URL=https://app.resqly.se

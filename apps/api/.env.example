# Resqly API (apps/api) — deployed to Railway or similar.
# All values are server-side; nothing here may be exposed to browsers/apps.

APP_ENV=production
PORT=4000

# Supabase (service role — server only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ byte pepper for hashing personal identity numbers. REQUIRED.
ENCRYPTION_KEY=

# BankID via TIC. Mock/test configurations are hard-blocked in production.
BANKID_PROVIDER=tic
BANKID_ENV=production
BANKID_MOCK_ENABLED=false
TIC_API_BASE_URL=https://id.tic.io/api/v1
TIC_API_KEY=
TIC_WEBHOOK_SECRET=
TIC_CALLBACK_BASE_URL=https://api.resqly.se

# Google Maps (server key only — never the browser key)
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_ROUTES_API_ENABLED=true
GOOGLE_MAPS_ROUTE_MATRIX_ENABLED=true

# Expo push
EXPO_PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Email (Resend)
NOTIFICATIONS_EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=Resqly <no-reply@mail.resqly.se>
EMAIL_REPLY_TO=support@resqly.se

# Customer web base URL (used by the BankID browser callback page)
APP_BASE_URL=https://app.resqly.se

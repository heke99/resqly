# Resqly customer web (apps/customer-web) — deployed to Vercel.

APP_ENV=production

# Supabase. The anon key is public; the service role key is server-only
# (used exclusively inside API routes).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# White-label domain resolution
PLATFORM_BASE_DOMAIN=resqly.se

# BankID via TIC (server-side API routes only)
BANKID_PROVIDER=tic
BANKID_ENV=production
BANKID_MOCK_ENABLED=false
TIC_API_BASE_URL=https://id.tic.io/api/v1
TIC_API_KEY=

# 32+ byte pepper for hashing personal identity numbers. REQUIRED.
ENCRYPTION_KEY=

# Google Maps server key — used server-side to geocode manual pickup addresses.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_GEOCODING_ENABLED=true

# Expo push (tow request offers are pushed to drivers from the API route)
EXPO_PUSH_ENABLED=true

# Resqly background workers (apps/workers) — deployed next to the API.

APP_ENV=production
WORKER_INTERVAL_MS=15000
# Optional stable deployment/instance identifier shown in admin readiness.
WORKER_INSTANCE_ID=

# Supabase (service role — server only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# BankID guard (workers refuse to start with mock config in production)
BANKID_PROVIDER=tic
BANKID_ENV=production
BANKID_MOCK_ENABLED=false

# Google Maps for ETA refresh (haversine fallback when unset)
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_ROUTES_API_ENABLED=true
GOOGLE_MAPS_ROUTE_MATRIX_ENABLED=true

# Expo push (offer push retries)
EXPO_PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Email (queued operational notifications)
NOTIFICATIONS_EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=Resqly <no-reply@mail.resqly.se>
EMAIL_REPLY_TO=support@resqly.se

# SMS fallback (46elks). Optional — leave disabled if no provider contract.
SMS_ENABLED=false
SMS_PROVIDER=46elks
SMS_API_KEY=
SMS_FROM=Resqly

# Resqly internal operations portal (apps/admin-web) — deployed to Vercel.
# Access restricted to platform admins.

APP_ENV=production

# Supabase. Anon key for browser auth; service role key server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap: the first user with this e-mail is promoted to platform admin
# on first login. Remove after onboarding the internal team.
FIRST_SUPERADMIN_EMAIL=

# Links shown in the portal
NEXT_PUBLIC_CUSTOMER_WEB_URL=https://app.resqly.se
NEXT_PUBLIC_PORTAL_WEB_URL=https://portal.resqly.se
NEXT_PUBLIC_API_URL=https://api.resqly.se

# Configuration status shown under "Drift & åtgärder" (read-only booleans;
# set the same values as the API/workers so the view reflects reality).
BANKID_PROVIDER=tic
TIC_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
RESEND_API_KEY=
EMAIL_FROM=
ENCRYPTION_KEY=
EXPO_PUSH_ENABLED=true
SMS_ENABLED=false
SMS_API_KEY=

# Resqly driver app (apps/driver-mobile) — Expo/EAS build profile env.
# Only EXPO_PUBLIC_* values are ever embedded in the app bundle.
# The app authenticates with the driver's own session token — it never
# contains an API key or any other secret.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=https://api.resqly.se

# EAS project id (push notifications)
EXPO_PUBLIC_PROJECT_ID=

# Resqly partner portal (apps/portal-web) — deployed to Vercel.
# Used by insurance companies and towing companies.

APP_ENV=production

# Supabase. Anon key for browser auth; service role key server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used in password reset/invite links.
NEXT_PUBLIC_PORTAL_WEB_URL=https://portal.resqly.se

# Exact HTTPS URL opened after a driver accepts the Supabase invite.
DRIVER_INVITE_REDIRECT_URL=https://portal.resqly.se/set-password
